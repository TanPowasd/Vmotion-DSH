{
  "name": "@vmotion/sdk",
  "version": "0.1.3",
  "private": true,
  "description": "Type declarations only for the Vmotion SDK (@vmotion/sdk) used by JSX components and plugins. No implementation: the runtime is supplied by Vmotion when it compiles project code.",
  "type": "module",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts"
    },
    "./jsx-runtime": {
      "types": "./jsx-runtime.d.ts"
    },
    "./jsx-dev-runtime": {
      "types": "./jsx-dev-runtime.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.d.ts",
    "jsx-runtime.d.ts",
    "jsx-dev-runtime.d.ts",
    "README.md"
  ],
  "dependencies": {
    "zod": "^3.25.76"
  }
}
