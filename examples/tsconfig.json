{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "jsx": "react-jsx",
    "jsxImportSource": "@vmotion/sdk",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "types": [],
    "preserveSymlinks": true
  },
  "include": ["*/components/**/*.ts", "*/components/**/*.tsx"]
}
