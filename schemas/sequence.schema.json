{
  "$ref": "#/definitions/sequence",
  "definitions": {
    "sequence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "name": {
          "type": "string"
        },
        "duration": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "tracks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/sequence/properties/id"
              },
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "video",
                  "audio"
                ]
              },
              "muted": {
                "type": "boolean",
                "default": false
              },
              "locked": {
                "type": "boolean"
              },
              "clips": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "$ref": "#/definitions/sequence/properties/id"
                    },
                    "sceneId": {
                      "$ref": "#/definitions/sequence/properties/id"
                    },
                    "sequenceId": {
                      "$ref": "#/definitions/sequence/properties/id"
                    },
                    "assetId": {
                      "$ref": "#/definitions/sequence/properties/id"
                    },
                    "start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "duration": {
                      "type": "integer",
                      "exclusiveMinimum": 0
                    },
                    "sourceIn": {
                      "type": "number",
                      "minimum": 0,
                      "default": 0
                    },
                    "sourceOut": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "speed": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "default": 1
                    },
                    "volume": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 4,
                      "default": 1
                    },
                    "fadeIn": {
                      "type": "integer",
                      "minimum": 0,
                      "default": 0
                    },
                    "fadeOut": {
                      "type": "integer",
                      "minimum": 0,
                      "default": 0
                    },
                    "name": {
                      "type": "string"
                    },
                    "linkedGroup": {
                      "$ref": "#/definitions/sequence/properties/id"
                    },
                    "audioEnabled": {
                      "type": "boolean"
                    },
                    "fadeWindow": {
                      "type": "object",
                      "properties": {
                        "offset": {
                          "type": "number"
                        },
                        "duration": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        }
                      },
                      "required": [
                        "offset",
                        "duration"
                      ],
                      "additionalProperties": false
                    },
                    "sourceWindow": {
                      "type": "object",
                      "properties": {
                        "sourceIn": {
                          "type": "number",
                          "minimum": 0
                        },
                        "duration": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        }
                      },
                      "required": [
                        "sourceIn",
                        "duration"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "id",
                    "start",
                    "duration"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "name",
              "type",
              "clips"
            ],
            "additionalProperties": false
          }
        },
        "workflow": {
          "type": "string",
          "enum": [
            "general",
            "remix",
            "film"
          ]
        },
        "mix": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "tracks": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "gainDb": {
                        "type": "number",
                        "minimum": -80,
                        "maximum": 24,
                        "default": 0
                      },
                      "pan": {
                        "type": "number",
                        "minimum": -1,
                        "maximum": 1,
                        "default": 0
                      },
                      "effects": {
                        "type": "array",
                        "items": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "type": {
                                  "type": "string",
                                  "const": "gain"
                                },
                                "db": {
                                  "type": "number",
                                  "minimum": -80,
                                  "maximum": 24
                                }
                              },
                              "required": [
                                "type",
                                "db"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "type": {
                                  "type": "string",
                                  "const": "filter"
                                },
                                "mode": {
                                  "type": "string",
                                  "enum": [
                                    "lowpass",
                                    "highpass",
                                    "peaking",
                                    "lowshelf",
                                    "highshelf"
                                  ]
                                },
                                "frequency": {
                                  "type": "number",
                                  "minimum": 10,
                                  "maximum": 22000
                                },
                                "q": {
                                  "type": "number",
                                  "minimum": 0.1,
                                  "maximum": 20,
                                  "default": 0.707
                                },
                                "db": {
                                  "type": "number",
                                  "minimum": -24,
                                  "maximum": 24,
                                  "default": 0
                                }
                              },
                              "required": [
                                "type",
                                "mode",
                                "frequency"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "type": {
                                  "type": "string",
                                  "const": "distortion"
                                },
                                "drive": {
                                  "type": "number",
                                  "minimum": 1,
                                  "maximum": 30,
                                  "default": 3
                                },
                                "mix": {
                                  "type": "number",
                                  "minimum": 0,
                                  "maximum": 1,
                                  "default": 0.5
                                }
                              },
                              "required": [
                                "type"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "type": {
                                  "type": "string",
                                  "const": "delay"
                                },
                                "seconds": {
                                  "type": "number",
                                  "minimum": 0.001,
                                  "maximum": 3,
                                  "default": 0.25
                                },
                                "rightSeconds": {
                                  "type": "number",
                                  "minimum": 0.001,
                                  "maximum": 3
                                },
                                "feedback": {
                                  "type": "number",
                                  "minimum": 0,
                                  "maximum": 0.9,
                                  "default": 0.3
                                },
                                "mix": {
                                  "type": "number",
                                  "minimum": 0,
                                  "maximum": 1,
                                  "default": 0.25
                                }
                              },
                              "required": [
                                "type"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "type": {
                                  "type": "string",
                                  "const": "chorus"
                                },
                                "rate": {
                                  "type": "number",
                                  "minimum": 0.01,
                                  "maximum": 10,
                                  "default": 0.8
                                },
                                "depth": {
                                  "type": "number",
                                  "minimum": 0,
                                  "maximum": 0.015,
                                  "default": 0.003
                                },
                                "delay": {
                                  "type": "number",
                                  "minimum": 0.016,
                                  "maximum": 0.05,
                                  "default": 0.02
                                },
                                "mix": {
                                  "type": "number",
                                  "minimum": 0,
                                  "maximum": 1,
                                  "default": 0.3
                                }
                              },
                              "required": [
                                "type"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "type": {
                                  "type": "string",
                                  "const": "reverb"
                                },
                                "seconds": {
                                  "type": "number",
                                  "minimum": 0.1,
                                  "maximum": 8,
                                  "default": 1.5
                                },
                                "damping": {
                                  "type": "number",
                                  "minimum": 0,
                                  "maximum": 0.95,
                                  "default": 0.4
                                },
                                "mix": {
                                  "type": "number",
                                  "minimum": 0,
                                  "maximum": 1,
                                  "default": 0.2
                                }
                              },
                              "required": [
                                "type"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "type": {
                                  "type": "string",
                                  "const": "compressor"
                                },
                                "thresholdDb": {
                                  "type": "number",
                                  "minimum": -60,
                                  "maximum": 0,
                                  "default": -18
                                },
                                "ratio": {
                                  "type": "number",
                                  "minimum": 1,
                                  "maximum": 30,
                                  "default": 4
                                },
                                "kneeDb": {
                                  "type": "number",
                                  "minimum": 0,
                                  "maximum": 24,
                                  "default": 6
                                },
                                "attack": {
                                  "type": "number",
                                  "minimum": 0.0001,
                                  "maximum": 0.5,
                                  "default": 0.01
                                },
                                "release": {
                                  "type": "number",
                                  "minimum": 0.001,
                                  "maximum": 3,
                                  "default": 0.15
                                },
                                "makeupDb": {
                                  "type": "number",
                                  "minimum": 0,
                                  "maximum": 24,
                                  "default": 0
                                }
                              },
                              "required": [
                                "type"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "type": {
                                  "type": "string",
                                  "const": "limiter"
                                },
                                "ceilingDb": {
                                  "type": "number",
                                  "minimum": -24,
                                  "maximum": 0,
                                  "default": -1
                                },
                                "release": {
                                  "type": "number",
                                  "minimum": 0.001,
                                  "maximum": 3,
                                  "default": 0.1
                                }
                              },
                              "required": [
                                "type"
                              ],
                              "additionalProperties": false
                            }
                          ]
                        },
                        "maxItems": 12,
                        "default": []
                      },
                      "ducking": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "source": {
                                "type": "object",
                                "properties": {
                                  "type": {
                                    "type": "string",
                                    "enum": [
                                      "track",
                                      "bus"
                                    ]
                                  },
                                  "id": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 200
                                  }
                                },
                                "required": [
                                  "type",
                                  "id"
                                ],
                                "additionalProperties": false
                              },
                              "thresholdDb": {
                                "type": "number",
                                "minimum": -60,
                                "maximum": 0,
                                "default": -24
                              },
                              "ratio": {
                                "type": "number",
                                "minimum": 1,
                                "maximum": 20,
                                "default": 4
                              },
                              "kneeDb": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 24,
                                "default": 6
                              },
                              "attack": {
                                "type": "number",
                                "minimum": 0.0001,
                                "maximum": 2,
                                "default": 0.01
                              },
                              "release": {
                                "type": "number",
                                "minimum": 0.001,
                                "maximum": 9,
                                "default": 0.25
                              },
                              "maxReductionDb": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 60,
                                "default": 24
                              }
                            },
                            "required": [
                              "source"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "busId": {
                        "$ref": "#/definitions/sequence/properties/mix/anyOf/0/properties/tracks/additionalProperties/properties/ducking/anyOf/0/properties/source/properties/id",
                        "default": "master"
                      },
                      "sends": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "busId": {
                              "$ref": "#/definitions/sequence/properties/mix/anyOf/0/properties/tracks/additionalProperties/properties/ducking/anyOf/0/properties/source/properties/id"
                            },
                            "db": {
                              "type": "number",
                              "minimum": -80,
                              "maximum": 12,
                              "default": -12
                            }
                          },
                          "required": [
                            "busId"
                          ],
                          "additionalProperties": false
                        },
                        "maxItems": 8,
                        "default": []
                      },
                      "solo": {
                        "type": "boolean",
                        "default": false
                      },
                      "automation": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "property": {
                              "type": "string",
                              "enum": [
                                "gainDb",
                                "pan"
                              ]
                            },
                            "keys": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "at": {
                                    "type": "number",
                                    "minimum": 0
                                  },
                                  "value": {
                                    "type": "number"
                                  },
                                  "easing": {
                                    "type": "string",
                                    "enum": [
                                      "linear",
                                      "hold"
                                    ],
                                    "default": "linear"
                                  }
                                },
                                "required": [
                                  "at",
                                  "value"
                                ],
                                "additionalProperties": false
                              },
                              "minItems": 1,
                              "maxItems": 2000
                            }
                          },
                          "required": [
                            "property",
                            "keys"
                          ],
                          "additionalProperties": false
                        },
                        "maxItems": 2,
                        "default": []
                      }
                    },
                    "additionalProperties": false
                  },
                  "default": {}
                },
                "buses": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "gainDb": {
                        "$ref": "#/definitions/sequence/properties/mix/anyOf/0/properties/tracks/additionalProperties/properties/gainDb"
                      },
                      "pan": {
                        "$ref": "#/definitions/sequence/properties/mix/anyOf/0/properties/tracks/additionalProperties/properties/pan"
                      },
                      "effects": {
                        "$ref": "#/definitions/sequence/properties/mix/anyOf/0/properties/tracks/additionalProperties/properties/effects"
                      },
                      "ducking": {
                        "$ref": "#/definitions/sequence/properties/mix/anyOf/0/properties/tracks/additionalProperties/properties/ducking"
                      },
                      "busId": {
                        "$ref": "#/definitions/sequence/properties/mix/anyOf/0/properties/tracks/additionalProperties/properties/busId"
                      },
                      "sends": {
                        "$ref": "#/definitions/sequence/properties/mix/anyOf/0/properties/tracks/additionalProperties/properties/sends"
                      },
                      "automation": {
                        "$ref": "#/definitions/sequence/properties/mix/anyOf/0/properties/tracks/additionalProperties/properties/automation"
                      },
                      "id": {
                        "$ref": "#/definitions/sequence/properties/mix/anyOf/0/properties/tracks/additionalProperties/properties/ducking/anyOf/0/properties/source/properties/id"
                      },
                      "name": {
                        "type": "string",
                        "default": "Bus"
                      }
                    },
                    "required": [
                      "id"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 16,
                  "default": []
                },
                "master": {
                  "type": "object",
                  "properties": {
                    "gainDb": {
                      "$ref": "#/definitions/sequence/properties/mix/anyOf/0/properties/tracks/additionalProperties/properties/gainDb"
                    },
                    "pan": {
                      "$ref": "#/definitions/sequence/properties/mix/anyOf/0/properties/tracks/additionalProperties/properties/pan"
                    },
                    "effects": {
                      "$ref": "#/definitions/sequence/properties/mix/anyOf/0/properties/tracks/additionalProperties/properties/effects"
                    },
                    "ducking": {
                      "$ref": "#/definitions/sequence/properties/mix/anyOf/0/properties/tracks/additionalProperties/properties/ducking"
                    },
                    "gainStage": {
                      "type": "string",
                      "enum": [
                        "pre",
                        "post"
                      ],
                      "default": "pre"
                    },
                    "normalization": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "targetLufs": {
                              "type": "number",
                              "minimum": -36,
                              "maximum": -5,
                              "default": -16
                            },
                            "targetLra": {
                              "type": "number",
                              "minimum": 1,
                              "maximum": 50,
                              "default": 11
                            },
                            "truePeakDb": {
                              "type": "number",
                              "minimum": -9,
                              "maximum": 0,
                              "default": -1
                            },
                            "mode": {
                              "type": "string",
                              "enum": [
                                "auto",
                                "linear",
                                "dynamic"
                              ],
                              "default": "auto"
                            }
                          },
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "additionalProperties": false,
                  "default": {}
                },
                "scratchBudgetMb": {
                  "type": "integer",
                  "minimum": 64,
                  "maximum": 131072,
                  "default": 20480
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "workArea": {
          "type": "object",
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false
        },
        "markers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/sequence/properties/id"
              },
              "frame": {
                "type": "integer",
                "minimum": 0
              },
              "label": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "marker",
                  "beat",
                  "chapter"
                ]
              },
              "group": {
                "$ref": "#/definitions/sequence/properties/id"
              }
            },
            "required": [
              "id",
              "frame",
              "label"
            ],
            "additionalProperties": false
          },
          "default": []
        }
      },
      "required": [
        "id",
        "name",
        "duration",
        "tracks"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
