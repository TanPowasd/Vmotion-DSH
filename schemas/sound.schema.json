{
  "$ref": "#/definitions/sound",
  "definitions": {
    "sound": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "sound"
        },
        "version": {
          "type": "number",
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "enum": [
            "beats",
            "seconds"
          ],
          "default": "beats"
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 14400
        },
        "tail": {
          "type": "number",
          "minimum": 0,
          "maximum": 20,
          "default": 1
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "default": 1
        },
        "tempo": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "beat": {
                "type": "number",
                "minimum": 0
              },
              "bpm": {
                "type": "number",
                "minimum": 20,
                "maximum": 400
              }
            },
            "required": [
              "beat",
              "bpm"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 1000,
          "default": [
            {
              "beat": 0,
              "bpm": 120
            }
          ]
        },
        "timeSignature": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            {
              "type": "number",
              "enum": [
                2,
                4,
                8,
                16
              ]
            }
          ],
          "default": [
            4,
            4
          ]
        },
        "tracks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/sound/properties/id"
              },
              "name": {
                "type": "string",
                "default": "Track"
              },
              "instrument": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "format": {
                        "type": "string",
                        "enum": [
                          "vst3",
                          "au"
                        ]
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024
                      },
                      "classId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "name": {
                        "type": "string",
                        "maxLength": 200
                      },
                      "fingerprint": {
                        "type": "string",
                        "maxLength": 300
                      },
                      "parameters": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "propertyNames": {
                          "pattern": "^\\d+$"
                        },
                        "default": {}
                      },
                      "state": {
                        "type": "string",
                        "maxLength": 2097152,
                        "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                      },
                      "controllerState": {
                        "type": "string",
                        "maxLength": 2097152,
                        "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                      },
                      "type": {
                        "type": "string",
                        "const": "plugin"
                      },
                      "release": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 10,
                        "default": 0
                      }
                    },
                    "required": [
                      "format",
                      "path",
                      "classId",
                      "type"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "synth"
                      },
                      "wave": {
                        "type": "string",
                        "enum": [
                          "sine",
                          "triangle",
                          "saw",
                          "square",
                          "noise"
                        ],
                        "default": "sine"
                      },
                      "gain": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 2,
                        "default": 0.3
                      },
                      "attack": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 10,
                        "default": 0.008
                      },
                      "decay": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 10,
                        "default": 0.15
                      },
                      "sustain": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1,
                        "default": 0.6
                      },
                      "release": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 10,
                        "default": 0.2
                      },
                      "fmRatio": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 20,
                        "default": 0
                      },
                      "fmIndex": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 20,
                        "default": 0
                      },
                      "detune": {
                        "type": "number",
                        "minimum": -100,
                        "maximum": 100,
                        "default": 0
                      }
                    },
                    "required": [
                      "type"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "drum"
                      },
                      "voice": {
                        "type": "string",
                        "enum": [
                          "kick",
                          "snare",
                          "hat",
                          "tom",
                          "clap"
                        ]
                      },
                      "gain": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 2,
                        "default": 0.5
                      },
                      "release": {
                        "type": "number",
                        "minimum": 0.01,
                        "maximum": 3,
                        "default": 0.3
                      }
                    },
                    "required": [
                      "type",
                      "voice"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "sample"
                      },
                      "assetId": {
                        "$ref": "#/definitions/sound/properties/id"
                      },
                      "sourceIn": {
                        "type": "number",
                        "minimum": 0,
                        "default": 0
                      },
                      "sourceDuration": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 1800
                      },
                      "rootNote": {
                        "anyOf": [
                          {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 127
                          },
                          {
                            "type": "string",
                            "pattern": "^[A-Ga-g](?:#|b)?-?\\d{1,2}$"
                          }
                        ],
                        "default": 60
                      },
                      "loop": {
                        "type": "boolean",
                        "default": false
                      },
                      "attack": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 10,
                        "default": 0.005
                      },
                      "release": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 10,
                        "default": 0.05
                      },
                      "gain": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 2,
                        "default": 1
                      }
                    },
                    "required": [
                      "type",
                      "assetId",
                      "sourceDuration"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "events": {
                "type": "array",
