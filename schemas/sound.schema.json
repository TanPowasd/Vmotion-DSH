                    },
                    "endNote": {
                      "$ref": "#/definitions/sound/properties/tracks/items/properties/instrument/anyOf/3/properties/rootNote"
                    },
                    "velocity": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "default": 0.8
                    },
                    "pan": {
                      "type": "number",
                      "minimum": -1,
                      "maximum": 1,
                      "default": 0
                    }
                  },
                  "required": [
                    "id",
                    "at",
                    "duration"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 20000,
                "default": []
              },
              "muted": {
                "type": "boolean",
                "default": false
              },
              "solo": {
                "type": "boolean",
                "default": false
              },
              "gainDb": {
                "type": "number",
                "minimum": -80,
                "maximum": 24,
                "default": 0
              },
              "pan": {
                "type": "number",
                "minimum": -1,
                "maximum": 1,
                "default": 0
              },
              "busId": {
                "$ref": "#/definitions/sound/properties/id",
                "default": "master"
              },
              "sends": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "busId": {
                      "$ref": "#/definitions/sound/properties/id"
                    },
                    "db": {
                      "type": "number",
                      "minimum": -80,
                      "maximum": 12,
                      "default": -12
                    }
                  },
                  "required": [
                    "busId"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 8,
                "default": []
              },
              "effects": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "gain"
                        },
                        "db": {
                          "type": "number",
                          "minimum": -80,
                          "maximum": 24
                        }
                      },
                      "required": [
                        "type",
                        "db"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "filter"
                        },
                        "mode": {
                          "type": "string",
                          "enum": [
                            "lowpass",
                            "highpass",
                            "peaking",
                            "lowshelf",
                            "highshelf"
                          ]
                        },
                        "frequency": {
                          "type": "number",
                          "minimum": 10,
                          "maximum": 22000
                        },
                        "q": {
                          "type": "number",
                          "minimum": 0.1,
                          "maximum": 20,
                          "default": 0.707
                        },
                        "db": {
                          "type": "number",
                          "minimum": -24,
                          "maximum": 24,
                          "default": 0
                        }
                      },
                      "required": [
                        "type",
                        "mode",
                        "frequency"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "distortion"
                        },
                        "drive": {
                          "type": "number",
                          "minimum": 1,
                          "maximum": 30,
                          "default": 3
                        },
                        "mix": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1,
                          "default": 0.5
                        }
                      },
                      "required": [
                        "type"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "delay"
                        },
                        "seconds": {
                          "type": "number",
                          "minimum": 0.001,
                          "maximum": 3,
                          "default": 0.25
                        },
                        "rightSeconds": {
                          "type": "number",
                          "minimum": 0.001,
                          "maximum": 3
                        },
                        "feedback": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 0.9,
                          "default": 0.3
                        },
                        "mix": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1,
                          "default": 0.25
                        }
                      },
                      "required": [
                        "type"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "chorus"
                        },
                        "rate": {
                          "type": "number",
                          "minimum": 0.01,
                          "maximum": 10,
                          "default": 0.8
                        },
                        "depth": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 0.015,
                          "default": 0.003
                        },
                        "delay": {
                          "type": "number",
                          "minimum": 0.016,
                          "maximum": 0.05,
                          "default": 0.02
                        },
                        "mix": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1,
                          "default": 0.3
                        }
                      },
                      "required": [
                        "type"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "reverb"
                        },
                        "seconds": {
                          "type": "number",
                          "minimum": 0.1,
                          "maximum": 8,
                          "default": 1.5
                        },
                        "damping": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 0.95,
                          "default": 0.4
                        },
                        "mix": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1,
                          "default": 0.2
                        }
                      },
                      "required": [
                        "type"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "compressor"
                        },
                        "thresholdDb": {
                          "type": "number",
                          "minimum": -60,
                          "maximum": 0,
                          "default": -18
                        },
                        "ratio": {
                          "type": "number",
                          "minimum": 1,
                          "maximum": 30,
                          "default": 4
                        },
                        "kneeDb": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 24,
                          "default": 6
                        },
                        "attack": {
                          "type": "number",
                          "minimum": 0.0001,
                          "maximum": 0.5,
                          "default": 0.01
                        },
                        "release": {
                          "type": "number",
                          "minimum": 0.001,
                          "maximum": 3,
                          "default": 0.15
                        },
                        "makeupDb": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 24,
                          "default": 0
                        }
                      },
                      "required": [
                        "type"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "limiter"
                        },
                        "ceilingDb": {
                          "type": "number",
                          "minimum": -24,
                          "maximum": 0,
                          "default": -1
                        },
                        "release": {
                          "type": "number",
                          "minimum": 0.001,
                          "maximum": 3,
                          "default": 0.1
                        }
                      },
                      "required": [
                        "type"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "format": {
                          "$ref": "#/definitions/sound/properties/tracks/items/properties/instrument/anyOf/0/properties/format"
                        },
                        "path": {
                          "$ref": "#/definitions/sound/properties/tracks/items/properties/instrument/anyOf/0/properties/path"
                        },
                        "classId": {
                          "$ref": "#/definitions/sound/properties/tracks/items/properties/instrument/anyOf/0/properties/classId"
                        },
                        "name": {
                          "$ref": "#/definitions/sound/properties/tracks/items/properties/instrument/anyOf/0/properties/name"
                        },
                        "fingerprint": {
                          "$ref": "#/definitions/sound/properties/tracks/items/properties/instrument/anyOf/0/properties/fingerprint"
                        },
                        "parameters": {
                          "$ref": "#/definitions/sound/properties/tracks/items/properties/instrument/anyOf/0/properties/parameters"
                        },
                        "state": {
                          "$ref": "#/definitions/sound/properties/tracks/items/properties/instrument/anyOf/0/properties/state"
                        },
                        "controllerState": {
                          "$ref": "#/definitions/sound/properties/tracks/items/properties/instrument/anyOf/0/properties/controllerState"
                        },
                        "type": {
                          "type": "string",
                          "const": "plugin"
                        }
                      },
                      "required": [
                        "format",
                        "path",
                        "classId",
                        "type"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "maxItems": 12,
                "default": []
              },
              "automation": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "property": {
                      "type": "string",
                      "enum": [
                        "gainDb",
                        "pan"
                      ]
                    },
                    "keys": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "at": {
                            "type": "number",
                            "minimum": 0
                          },
                          "value": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "at",
                          "value"
                        ],
                        "additionalProperties": false
                      },
                      "minItems": 1,
                      "maxItems": 2000
                    }
                  },
                  "required": [
                    "property",
                    "keys"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 2,
                "default": []
              }
            },
            "required": [
              "id",
              "instrument"
            ],
            "additionalProperties": false
          },
          "maxItems": 64,
          "default": []
        },
        "patterns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/sound/properties/id"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "length": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 14400
              },
              "channels": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "trackId": {
                      "$ref": "#/definitions/sound/properties/id"
                    },
                    "events": {
                      "type": "array",
                      "items": {
                        "$ref": "#/definitions/sound/properties/tracks/items/properties/events/items"
                      },
                      "maxItems": 20000,
                      "default": []
                    }
                  },
                  "required": [
                    "trackId"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 64
              }
            },
            "required": [
              "id",
              "name",
              "length",
              "channels"
            ],
            "additionalProperties": false
          },
          "maxItems": 128
        },
        "arrangement": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/sound/properties/id"
              },
              "patternId": {
                "$ref": "#/definitions/sound/properties/id"
              },
              "at": {
                "type": "number",
                "minimum": 0
              },
              "repeats": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1024,
                "default": 1
              }
            },
            "required": [
              "id",
              "patternId",
              "at"
            ],
            "additionalProperties": false
          },
          "maxItems": 2000
        },
        "buses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/sound/properties/id"
              },
              "name": {
                "type": "string",
                "default": "Bus"
              },
              "busId": {
                "$ref": "#/definitions/sound/properties/id",
                "default": "master"
              },
              "gainDb": {
                "type": "number",
                "minimum": -80,
                "maximum": 24,
                "default": 0
              },
              "pan": {
                "type": "number",
                "minimum": -1,
                "maximum": 1,
                "default": 0
              },
              "sends": {
                "$ref": "#/definitions/sound/properties/tracks/items/properties/sends"
              },
              "effects": {
                "$ref": "#/definitions/sound/properties/tracks/items/properties/effects"
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          },
          "maxItems": 16,
          "default": []
        },
        "master": {
          "type": "object",
          "properties": {
            "gainDb": {
              "type": "number",
              "minimum": -80,
              "maximum": 24,
              "default": 0
            },
            "gainStage": {
              "type": "string",
              "enum": [
                "pre",
                "post"
              ],
              "default": "pre"
            },
            "effects": {
              "$ref": "#/definitions/sound/properties/tracks/items/properties/effects"
            },
            "loudness": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "targetLufs": {
                      "anyOf": [
                        {
                          "type": "number",
                          "minimum": -36,
                          "maximum": -5
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "default": -14
                    },
                    "truePeakDb": {
                      "anyOf": [
                        {
                          "type": "number",
                          "minimum": -9,
                          "maximum": 0
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "default": -1
                    },
                    "maxGainDb": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 36,
                      "default": 24
                    },
                    "release": {
                      "type": "number",
                      "minimum": 0.001,
                      "maximum": 1,
                      "default": 0.05
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "default": {}
        }
      },
      "required": [
        "kind",
        "version",
        "id",
        "name",
        "duration"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
