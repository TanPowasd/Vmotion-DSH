{
  "$ref": "#/definitions/still",
  "definitions": {
    "still": {
      "type": "object",
      "properties": {
        "preset": {
          "type": "string",
          "maxLength": 64
        },
        "dpi": {
          "type": "integer",
          "minimum": 36,
          "maximum": 2400,
          "default": 72
        },
        "bleed": {
          "type": "number",
          "minimum": 0,
          "maximum": 1024,
          "default": 0
        },
        "safeArea": {
          "type": "number",
          "minimum": 0,
          "maximum": 4096,
          "default": 0
        },
        "transparent": {
          "type": "boolean",
          "default": false
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[\\w.-]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "width": {
                "type": "integer",
                "minimum": 16,
                "maximum": 8192
              },
              "height": {
                "type": "integer",
                "minimum": 16,
                "maximum": 8192
              },
              "fit": {
                "type": "string",
                "enum": [
                  "contain",
                  "cover",
                  "reflow"
                ],
                "default": "contain"
              },
              "background": {
                "type": "string",
                "minLength": 1
              },
              "preset": {
                "type": "string",
                "maxLength": 64
              }
            },
            "required": [
              "id",
              "name",
              "width",
              "height"
            ],
            "additionalProperties": false
          },
          "maxItems": 16,
          "default": []
        }
      },
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
