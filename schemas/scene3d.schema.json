{
  "$ref": "#/definitions/scene3d",
  "definitions": {
    "scene3d": {
      "type": "object",
      "properties": {
        "camera": {
          "type": "object",
          "properties": {
            "position": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "$ref": "#/definitions/scene3d/properties/camera/properties/position/properties/x"
                },
                "z": {
                  "$ref": "#/definitions/scene3d/properties/camera/properties/position/properties/x"
                }
              },
              "required": [
                "x",
                "y",
                "z"
              ],
              "additionalProperties": false
            },
            "target": {
              "$ref": "#/definitions/scene3d/properties/camera/properties/position"
            },
            "up": {
              "$ref": "#/definitions/scene3d/properties/camera/properties/position"
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 3840
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 2160
            },
            "fov": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 178.99
            },
            "near": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "far": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "projection": {
              "type": "string",
              "enum": [
                "perspective",
                "orthographic"
              ]
            },
            "orthographicHeight": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "position",
            "target",
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        "instances": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "parentId": {
                "type": "string"
              },
              "mesh": {
                "type": "object",
                "properties": {
                  "vertices": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/scene3d/properties/camera/properties/position"
                    },
                    "maxItems": 100000
                  },
                  "faces": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "minItems": 3,
                      "maxItems": 64
                    },
                    "maxItems": 5000
                  },
                  "colors": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 5000
                  },
                  "cornerNormals": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "$ref": "#/definitions/scene3d/properties/camera/properties/position"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "minItems": 3,
                      "maxItems": 64
                    },
                    "maxItems": 5000
                  }
                },
                "required": [
                  "vertices",
                  "faces"
                ],
                "additionalProperties": false
              },
              "meshSource": {
                "type": "string",
                "minLength": 1
              },
              "transform": {
                "type": "object",
                "properties": {
                  "position": {
                    "$ref": "#/definitions/scene3d/properties/camera/properties/position"
                  },
                  "rotation": {
                    "$ref": "#/definitions/scene3d/properties/camera/properties/position"
                  },
                  "scale": {
                    "$ref": "#/definitions/scene3d/properties/camera/properties/position"
                  },
                  "pivot": {
                    "$ref": "#/definitions/scene3d/properties/camera/properties/position"
                  }
                },
                "additionalProperties": false
              },
              "matrix": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/scene3d/properties/camera/properties/position/properties/x"
                },
                "minItems": 16,
                "maxItems": 16
              },
              "color": {
                "type": "string"
              },
              "material": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "enum": [
                      "standard",
                      "unlit"
                    ],
                    "default": "standard"
                  },
                  "color": {
                    "type": "string",
                    "pattern": "^#[\\da-f]{6}$"
                  },
                  "metallic": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 0
                  },
                  "roughness": {
                    "type": "number",
                    "minimum": 0.05,
                    "maximum": 1,
                    "default": 0.5
                  },
                  "emissive": {
                    "$ref": "#/definitions/scene3d/properties/instances/items/properties/material/properties/color",
                    "default": "#000000"
                  },
                  "emissiveIntensity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 8,
                    "default": 0
                  },
                  "shading": {
                    "type": "string",
                    "enum": [
                      "flat",
                      "smooth"
                    ],
                    "default": "smooth"
                  },
                  "creaseAngle": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 180,
                    "default": 60
                  },
                  "doubleSided": {
                    "type": "boolean",
                    "default": false
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          },
          "maxItems": 1000
        },
        "options": {
          "type": "object",
          "properties": {
            "cullBackfaces": {
              "type": "boolean"
            },
            "light": {
              "$ref": "#/definitions/scene3d/properties/camera/properties/position"
            },
            "ambient": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "lights": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "directional"
                      },
                      "direction": {
                        "type": "object",
                        "properties": {
                          "x": {
                            "type": "number"
                          },
                          "y": {
                            "$ref": "#/definitions/scene3d/properties/options/properties/lights/items/anyOf/0/properties/direction/properties/x"
                          },
                          "z": {
                            "$ref": "#/definitions/scene3d/properties/options/properties/lights/items/anyOf/0/properties/direction/properties/x"
                          }
                        },
                        "required": [
                          "x",
                          "y",
                          "z"
                        ],
                        "additionalProperties": false
                      },
                      "color": {
                        "$ref": "#/definitions/scene3d/properties/instances/items/properties/material/properties/color",
                        "default": "#ffffff"
                      },
                      "intensity": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100,
                        "default": 3
                      }
                    },
                    "required": [
                      "type",
                      "direction"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "point"
                      },
                      "position": {
                        "$ref": "#/definitions/scene3d/properties/options/properties/lights/items/anyOf/0/properties/direction"
                      },
                      "color": {
                        "$ref": "#/definitions/scene3d/properties/instances/items/properties/material/properties/color",
                        "default": "#ffffff"
                      },
                      "intensity": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1000,
                        "default": 10
                      },
                      "range": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      }
                    },
                    "required": [
                      "type",
                      "position"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "maxItems": 8
            },
            "exposure": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 16
            },
            "toneMapping": {
              "type": "string",
              "enum": [
                "none",
                "reinhard",
                "aces"
              ]
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "samples": {
          "type": "number",
          "enum": [
            1,
            4
          ],
          "default": 4
        }
      },
      "required": [
        "camera",
        "instances"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
