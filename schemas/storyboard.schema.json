{
  "$ref": "#/definitions/storyboard",
  "definitions": {
    "storyboard": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "storyboard"
        },
        "version": {
          "type": "number",
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "enum": [
            "frames",
            "seconds"
          ],
          "default": "frames"
        },
        "start": {
          "type": "number",
          "minimum": 0,
          "default": 0
        },
        "chapters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/storyboard/properties/id"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              }
            },
            "required": [
              "id",
              "name"
            ],
            "additionalProperties": false
          },
          "maxItems": 200,
          "default": []
        },
        "shots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/storyboard/properties/id"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "chapterId": {
                "$ref": "#/definitions/storyboard/properties/id"
              },
              "source": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "scene",
                      "asset",
                      "sequence"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "type",
                  "id"
                ],
                "additionalProperties": false
              },
              "duration": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "sourceIn": {
                "$ref": "#/definitions/storyboard/properties/start",
                "default": 0
              },
              "speed": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100,
                "default": 1
              },
              "audioEnabled": {
                "type": "boolean",
                "default": true
              },
              "narration": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "$ref": "#/definitions/storyboard/properties/id"
                    },
                    "assetId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "trackId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "offset": {
                      "$ref": "#/definitions/storyboard/properties/start",
                      "default": 0
                    },
                    "sourceIn": {
                      "$ref": "#/definitions/storyboard/properties/start",
                      "default": 0
                    },
                    "duration": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "volume": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 4,
                      "default": 1
                    },
                    "fadeIn": {
                      "$ref": "#/definitions/storyboard/properties/start",
                      "default": 0
                    },
                    "fadeOut": {
                      "$ref": "#/definitions/storyboard/properties/start",
                      "default": 0
                    }
                  },
                  "required": [
                    "id",
                    "assetId"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 8,
                "default": []
              }
            },
            "required": [
              "id",
              "name",
              "source"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 250
        }
      },
      "required": [
        "kind",
        "version",
        "id",
        "name",
        "shots"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
