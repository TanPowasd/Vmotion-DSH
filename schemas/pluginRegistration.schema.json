{
  "$ref": "#/definitions/pluginRegistration",
  "definitions": {
    "pluginRegistration": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "maxLength": 400,
          "pattern": "^components\\/[\\p{L}\\p{N}_./-]+\\.(?:json|ts|tsx)$"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "source"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
