{
  "$ref": "#/definitions/pathText",
  "definitions": {
    "pathText": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "offset": {
          "type": "number",
          "default": 0
        },
        "normalOffset": {
          "$ref": "#/definitions/pathText/properties/offset",
          "default": 0
        },
        "tracking": {
          "$ref": "#/definitions/pathText/properties/offset",
          "default": 0
        },
        "align": {
          "type": "string",
          "enum": [
            "start",
            "center",
            "end"
          ],
          "default": "start"
        },
        "reverse": {
          "type": "boolean",
          "default": false
        },
        "tangent": {
          "type": "boolean",
          "default": true
        },
        "overflow": {
          "type": "string",
          "enum": [
            "hide",
            "clamp",
            "loop"
          ],
          "default": "hide"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
